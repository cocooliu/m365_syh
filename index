<script>
const money = n => "NT$" + Math.round(n).toLocaleString("zh-TW");
function calculate(){
  const userInput=document.getElementById("users");
  const n=Number(userInput.value);
  const rate=Number(document.getElementById("rate").value);
  const raw=document.getElementById("mde").value.trim();
  const d=raw===""?null:Number(raw);
  if(!Number.isInteger(n)||n<1||n>300||
     !Number.isFinite(rate)||rate<0||
     (d!==null&&(!Number.isFinite(d)||d<0))){
    alert("請輸入 1–300 的整數人數，以及有效的非負費用。");
    return;
  }
  const rows=[
    ["基礎包｜Basic",225],
    ["基礎包＋桌面 Office｜Standard",450],
    ["標準包｜Premium",705],
    ["中階 A｜Premium＋內含商務端點防護",705],
    ["中階 B｜Premium＋適用 MDE P2 組合",
      d===null?null:705+d]
  ];
  document.getElementById("results").innerHTML=rows.map(([name,p])=>{
    if(p===null)return `<tr><td>${name}</td>
    <td colspan="3">待 MDE P2 正式報價；Premium 基座年費
    ${money(n*705*12)}，未包含 P2 增額。</td></tr>`;
    const month=n*p,year=month*12;
    return `<tr><td>${name}</td><td>${money(month)}</td>
    <td>${money(year)}</td><td>${money(year*1.05)}</td></tr>`;
  }).join("");
  document.getElementById("services").innerHTML=[
    ["基礎包",10,15,"含前置盤點、身分與郵件導入"],
    ["標準包",18,27,"含基礎＋Intune／條件式存取"],
    ["中階 A",25,38,"含標準＋商務端點防護與演練"]
  ].map(([name,a,b,desc])=>`<tr><td>${name}</td>
  <td>${a}–${b}</td><td>${money(a*rate)}–${money(b*rate)}</td>
  <td>${desc}</td></tr>`).join("");
}
calculate();
</script>
